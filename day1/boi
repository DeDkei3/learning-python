import json    # Импортируем модуль для работы с JSON-файлом сохранения
import os      # Импортируем модуль для проверки существования файла на диске
import random  # Импортируем модуль для генерации случайных чисел (урон, шансы)
import time    # Импортируем модуль времени для пауз в бою

FILE_NAME = "inventory_v2.json"  # Имя нашего файла с инвентарём
MAX_WEIGHT = 10.0                # Максимальная грузоподъёмность рюкзака (кг)


# --- 1. ФУНКЦИИ РАБОТЫ С ИНВЕНТАРЁМ (ИЗ ТВОЕГО TASKI4) ---

def load_inventory():
    """Загружает инвентарь из JSON или создаёт базовый, если файла нет"""
    if os.path.exists(FILE_NAME):
        with open(FILE_NAME, "r", encoding="utf-8") as f:
            return json.load(f)
    else:
        return [
            {"name": "Knife", "weight": 0.5, "damage": 15, "price": 100}
        ]


def save_inventory(inventory):
    """Сохраняет список предметов в JSON-файл"""
    with open(FILE_NAME, "w", encoding="utf-8") as f:
        json.dump(inventory, f, ensure_ascii=False, indent=4)


def get_total_weight(inventory):
    """Считает суммарный вес всех предметов в инвентаре"""
    return round(sum(item["weight"] for item in inventory), 2)


def get_best_weapon_damage(inventory):
    """Находит предмет с максимальным уроном в инвентаре"""
    if not inventory:
        return 0  # Если инвентарь пуст, бонус к урону 0
    # Находим максимальное значение по ключу 'damage' среди всех предметов
    best_weapon = max(inventory, key=lambda item: item.get("damage", 0))
    return best_weapon.get("damage", 0)


# --- 2. КЛАССЫ ИГРОКА И МОНСТРА ---

class Character:
    """Класс игрока, поддерживающий динамический расчёт урона от оружия"""
    def __init__(self, name, hp, base_damage, armor, inventory):
        self.name = name            # Имя героя
        self.max_hp = hp            # Максимальный запас здоровья
        self.hp = hp                # Текущее здоровье
        self.base_damage = base_damage  # Собственный урон героя (без оружия)
        self.armor = armor          # Броня
        self.inventory = inventory  # Ссылка на список предметов инвентаря

    def get_total_damage(self):
        """Полный урон = Базовый урон игрока + Урон лучшего оружия из инвентаря"""
        weapon_dmg = get_best_weapon_damage(self.inventory)
        return self.base_damage + weapon_dmg

    def is_alive(self):
        """Проверка: жив ли герой"""
        return self.hp > 0

    def take_damage(self, dmg):
        """Расчёт и нанесение входящего урона с учётом брони"""
        effective_damage = max(1, dmg - self.armor)  # Урон не может быть меньше 1
        self.hp -= effective_damage
        if self.hp < 0:
            self.hp = 0
        return effective_damage


class Monster:
    """Класс монстра, содержащий данные о выпадающем луте"""
    def __init__(self, name, hp, damage, exp_reward, loot_item):
        self.name = name              # Имя монстра
        self.max_hp = hp              # Максимальное HP
        self.hp = hp                  # Текущее HP
        self.damage = damage          # Урон монстра
        self.exp_reward = exp_reward  # Опыт за победу
        self.loot_item = loot_item    # Словарь предмета, который выпадает при смерти

    def is_alive(self):
        """Проверка: жив ли монстр"""
        return self.hp > 0

    def take_damage(self, dmg):
        """Получение урона монстром"""
        self.hp -= dmg
        if self.hp < 0:
            self.hp = 0
        return dmg


# --- 3. ФУНКЦИЯ ДОБАВЛЕНИЯ ЛУТА В ИНВЕНТАРЬ ---

def add_loot_to_inventory(inventory, item):
    """Пытается добавить выбитый предмет в инвентарь с проверкой веса"""
    current_weight = get_total_weight(inventory)  # Считаем текущий вес рюкзака
    item_weight = item["weight"]                  # Узнаем вес выбитого предмета
    free_space = round(MAX_WEIGHT - current_weight, 2)  # Считаем свободное место

    print(f"\n🎁 Выпал лут: {item['name']} (Вес: {item_weight} кг | ⚔️Урон: {item['damage']} | 💰Цена: {item['price']})")

    # Проверка на перевес
    if item_weight <= free_space:
        inventory.append(item)        # Добавляем предмет в список
        save_inventory(inventory)     # Сохраняем обновленный инвентарь в JSON
        print(f"✅ Предмет '{item['name']}' успешно уложен в рюкзак и сохранён!")
    else:
        print(f"❌ Рюкзак переполнен! Нехватает места ({item_weight} кг > {free_space} кг доступных).")
        print(f"⚠️ Предмет '{item['name']}' пришлось оставить на земле.")


# --- 4. МЕХАНИКА ПОШАГОВОГО БОЯ ---

def battle(player, monster):
    """Главный цикл сражения"""
    print(f"\n⚔️ НАЧАЛО БОЯ: {player.name} VS {monster.name}! ⚔️")
    print(f"🗡 Твой итоговый урон: {player.get_total_damage()} (Базовый {player.base_damage} + Оружие {get_best_weapon_damage(player.inventory)})")
    
    turn = 1
    while player.is_alive() and monster.is_alive():
        print(f"\n--- Ход {turn} ---")
        print(f"❤️ {player.name}: {player.hp}/{player.max_hp} HP | 👾 {monster.name}: {monster.hp}/{monster.max_hp} HP")
        print("1. Атаковать")
        print("2. Защититься (+5 к броне на 1 ход)")
        print("3. Сбежать")
        
        choice = input("Твоё действие (1-3): ").strip()
        
        # --- ХОД ИГРОКА ---
        if choice == "1":
            total_dmg = player.get_total_damage()  # Получаем суммарный урон с оружием
            actual_dmg = random.randint(total_dmg - 2, total_dmg + 2)  # Небольшой разброс +-2
            dealt = monster.take_damage(actual_dmg)
            print(f"💥 Ты нанёс {monster.name} {dealt} урона!")
            
        elif choice == "2":
            print("🛡 Ты встал в глухую защиту!")
            player.armor += 5
            
        elif choice == "3":
            if random.random() < 0.5:  # 50% шанс успеха
                print("🏃 Ты успешно сбежал!")
                return "fled"
            else:
                print("❌ Побег не удался!")
        else:
            print("🤔 Ты замешкался и пропустил ход!")

        # Проверка смерти монстра
        if not monster.is_alive():
            print(f"\n🎉 ПОБЕДА! {monster.name} повержен!")
            print(f"✨ Получено опыта: {monster.exp_reward}")
            # Вызываем функцию укладки выбитого предмета в рюкзак
            add_loot_to_inventory(player.inventory, monster.loot_item)
            return "win"

        # --- ХОД МОНСТРА ---
        time.sleep(1)
        taken = player.take_damage(monster.damage)
        print(f"👹 {monster.name} наносит тебе {taken} урона!")

        # Сбрасываем временную броню после защиты
        if choice == "2":
            player.armor -= 5

        # Проверка смерти игрока
        if not player.is_alive():
            print(f"\n☠️ ВЫ ПОГИБЛИ... Игра окончена.")
            return "lose"

        turn += 1


# --- ТОЧКА ВХОДА ---
if __name__ == "__main__":
    # 1. Загружаем сохранённый инвентарь из JSON
    user_inventory = load_inventory()

    # 2. Создаём героя, передавая ему загруженный инвентарь
    hero = Character(
        name="Александр", 
        hp=60, 
        base_damage=5, 
        armor=2, 
        inventory=user_inventory
    )

    # 3. Создаём врага с конкретным предметом в качестве лута
    goblin_loot = {"name": "Goblin Spear", "weight": 1.2, "damage": 22, "price": 80}
    goblin = Monster(
        name="Гоблин-копейщик", 
        hp=35, 
        damage=9, 
        exp_reward=30, 
        loot_item=goblin_loot
    )

    # 4. Запускаем бой!
    battle(hero, goblin)