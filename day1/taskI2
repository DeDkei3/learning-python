inventory = ["pan", "knife", "rope", "water", "food"]

print(f"u have {inventory}")

# ГЛАВНЫЙ ЦИКЛ
while True:
    print("\n--- INVENTORY ---")
    print(f"u have now: {inventory}")
    print("1. add item")
    print("2. check item")
    print("3. exit")
    
    choice = input("choose an option (1-3): ")
    
    # 1. ДОБАВЛЕНИЕ ПРЕДМЕТОВ (С ПРОВЕРКОЙ НА ПУСТОТУ И ДУБЛИ)
    if choice == "1":
        print("Вводи предметы. Чтобы закончить добавление, напиши 'stop'.")
        
        while True:
            # .strip() сразу удаляет случайно набитые пробелы по краям
            new_item = input("Введите предмет: ").strip()
            
            # Выход из цикла
            if new_item.lower() == "stop":
                print("Вы закончили подбор предметов.")
                break
            
            # 1. ЗАЩИТА ОТ ПУСТОГО ВВОДА
            if new_item == "":
                print("❌ Название предмета не может быть пустым!")
                continue
                
            # 2. ЗАЩИТА ОТ ДУБЛИКАТОВ
            if new_item in inventory:
                print(f"❌ Предмет '{new_item}' уже есть в инвентаре!")
                continue
            
            # Если всё в порядке — добавляем
            inventory.append(new_item)
            print(f"Добавлено {new_item}! Теперь в инвентаре: {inventory}")
            
    # 2. ПРОВЕРКА И УДАЛЕНИЕ (С ЗАЩИТОЙ ОТ ВЫЛЕТОВ)
    elif choice == "2":
        if len(inventory) == 0:
            print("u inv empty now")
            continue
            
        try:
            max_slots = len(inventory)
            slot = int(input(f"какой слот проверить (1-{max_slots}): "))
            
            if slot <= 0:
                print("❌ Номер слота должен быть больше 0!")
                continue

            index = slot - 1
            chosen_item = inventory[index]
            
            print(f"в слоте {slot} лежит: {chosen_item}")
            sub_action = input("хочешь удалить или оставить этот предмет (1 удалить / 2 оставить): ")
            
            if sub_action == "1":
                removed = inventory.pop(index)
                print(f"вы выбросили {removed} из инвентаря")
            else:
                print(f"вы оставили {chosen_item} в инвентаре")

        except (ValueError, IndexError):
            print("❌ Ошибка! Вводи только существующий номер слота (цифрами)!")
            
    # 3. ВЫХОД
    elif choice == "3":
        print("выход из программы.")
        break
        
    else:
        print("Неверный выбор! Напиши 1, 2 или 3.")