import json
import os

FILE_NAME = "inventory.json"

# 1. ФУНКЦИЯ ЗАГРУЗКИ (Возвращает список)
def load_inventory():
    if os.path.exists(FILE_NAME):
        with open(FILE_NAME, "r", encoding="utf-8") as f:
            print("💾 Сохранение найдено! Инвентарь успешно загружен.")
            return json.load(f)
    else:
        print("🆕 Сохранение не найдено. Создан стандартный инвентарь.")
        return ["pan", "knife", "rope", "water", "food"]


# 2. ФУНКЦИЯ СОХРАНЕНИЯ (Принимает список, ничего не возвращает)
def save_inventory(inventory):
    with open(FILE_NAME, "w", encoding="utf-8") as f:
        json.dump(inventory, f, ensure_ascii=False, indent=4)


# 3. ФУНКЦИЯ ДОБАВЛЕНИЯ ПРЕДМЕТОВ
def add_items(inventory):
    print("Вводи предметы. Чтобы закончить добавление, напиши 'stop'.")
    while True:
        new_item = input("Введите предмет: ").strip()
        
        if new_item.lower() == "stop":
            print("Вы закончили подбор предметов.")
            break
            
        if new_item == "":
            print("❌ Название предмета не может быть пустым!")
            continue
            
        if new_item in inventory:
            print(f"❌ Предмет '{new_item}' уже есть в инвентаре!")
            continue
        
        inventory.append(new_item)
        save_inventory(inventory)  # Вызываем функцию сохранения
        print(f"Добавлено {new_item}! Теперь в инвентаре: {inventory}")


# 4. ФУНКЦИЯ ПРОВЕРКИ И УДАЛЕНИЯ
def remove_item(inventory):
    if len(inventory) == 0:
        print("u inv empty now")
        return  # Завершает работу функции и возвращает в меню

    try:
        max_slots = len(inventory)
        slot = int(input(f"какой слот проверить (1-{max_slots}): "))
        
        if slot <= 0:
            print("❌ Номер слота должен быть больше 0!")
            return

        index = slot - 1
        chosen_item = inventory[index]
        
        print(f"в слоте {slot} лежит: {chosen_item}")
        sub_action = input("хочешь удалить или оставить этот предмет (1 удалить / 2 оставить): ")
        
        if sub_action == "1":
            removed = inventory.pop(index)
            save_inventory(inventory)  # Автосохранение
            print(f"вы выбросили {removed} из инвентаря")
        else:
            print(f"вы оставили {chosen_item} в инвентаре")

    except (ValueError, IndexError):
        print("❌ Ошибка! Вводи только существующий номер слота (цифрами)!")


# 5. ГЛАВНАЯ ФУНКЦИЯ (Точка входа)
def main():
    inventory = load_inventory()
    print(f"u have {inventory}")

    while True:
        print("\n--- INVENTORY ---")
        print(f"u have now: {inventory}")
        print("1. add item")
        print("2. check item")
        print("3. exit")
        
        choice = input("choose an option (1-3): ")
        
        if choice == "1":
            add_items(inventory)
        elif choice == "2":
            remove_item(inventory)
        elif choice == "3":
            print("выход из программы.")
            break
        else:
            print("Неверный выбор! Напиши 1, 2 или 3.")


# Запуск программы
if __name__ == "__main__":
    main()