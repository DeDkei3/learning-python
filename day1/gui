import tkinter as tk
from tkinter import messagebox

class GameGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("RPG Боёвка")
        self.root.geometry("400x350")

        # Характеристики
        self.player_hp = 50
        self.monster_hp = 30

        # Виджеты (Элементы окна)
        self.label_title = tk.Label(root, text="⚔️ Бой с Гоблином", font=("Arial", 16, "bold"))
        self.label_title.pack(pady=10)

        self.label_player = tk.Label(root, text=f"Игрок HP: {self.player_hp}/50", font=("Arial", 12))
        self.label_player.pack()

        self.label_monster = tk.Label(root, text=f"Гоблин HP: {self.monster_hp}/30", font=("Arial", 12))
        self.label_monster.pack(pady=5)

        # Текстовое поле для лога боя
        self.log = tk.Text(root, height=8, width=45)
        self.log.pack(pady=10)

        # Кнопки действий
        self.btn_attack = tk.Button(root, text="⚔️ Атаковать", command=self.attack, width=15)
        self.btn_attack.pack(pady=2)

    def attack(self):
        if self.monster_hp > 0 and self.player_hp > 0:
            # Ход игрока
            self.monster_hp -= 10
            self.log.insert(tk.END, "Ты нанёс Гоблину 10 урона!\n")
            
            # Ход монстра (если жив)
            if self.monster_hp > 0:
                self.player_hp -= 5
                self.log.insert(tk.END, "Гоблин нанёс тебе 5 урона!\n")
            else:
                self.log.insert(tk.END, "🎉 ПОБЕДА!\n")
                messagebox.showinfo("Победа", "Ты победил Гоблина!")

            # Обновляем текст на экране
            self.label_player.config(text=f"Игрок HP: {max(0, self.player_hp)}/50")
            self.label_monster.config(text=f"Гоблин HP: {max(0, self.monster_hp)}/30")

# Запуск окна
root = tk.Tk()
app = GameGUI(root)
root.mainloop()