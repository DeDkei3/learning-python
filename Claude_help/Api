import requests

username = input("введите ник нейм польывателя на гетхабе:  ").strip()

url =f"https://api.github.com/users/{username}"

response = requests.get(url)

if response.status_code == 200:
    data = response.json()
    print(f"Ник пользывателя: {data["name"]}")
    print(f"пупбличный репазиториев: {data['public_repos']}")
    print(f"Дата регистрации: {data['created_at']}")
    print(f"email {data['email']}")
    print(data.keys())
else:
    print("пользыватель не найден")