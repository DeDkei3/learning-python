@app.route("/cart")
def view_cart():
    cart = session.get("cart", {})
    conn = get_db_connection()
    cursor = conn.cursor()

    cart_items = []
    total_price = 0.0

    for pid_str, quantity in cart.items():
        cursor.execute("SELECT * FROM inventory WHERE id = ?", (int(pid_str),))
        product = cursor.fetchone()
        if product:
            item_total = product["price"] * quantity
            total_price += item_total
            cart_items.append(
                {
                    "product": product,
                    "quantity": quantity,
                    "item_total": item_total,
                }
            )

    conn.close()
    return render_template(
        "cart.html", cart_items=cart_items, total_price=total_price
    )


@app.route("/cart/add/<int:product_id>", methods=["POST"])
def add_to_cart(product_id):
    cart = session.get("cart", {})
    pid_str = str(product_id)
    cart[pid_str] = cart.get(pid_str, 0) + 1
    session["cart"] = cart
    session.modified = True
    return redirect(request.referrer or url_for("view_cart"))


@app.route("/cart/update/<int:product_id>", methods=["POST"])
def update_cart(product_id):
    cart = session.get("cart", {})
    pid_str = str(product_id)
    action = request.form.get("action")

    if pid_str in cart:
        if action == "increase":
            cart[pid_str] += 1
        elif action == "decrease":
            cart[pid_str] -= 1
            if cart[pid_str] <= 0:
                del cart[pid_str]
        elif action == "delete":
            del cart[pid_str]

    session["cart"] = cart
    session.modified = True
    return redirect(url_for("view_cart"))


@app.route("/checkout", methods=["GET", "POST"])
def checkout():
    cart = session.get("cart", {})
    if not cart:
        return redirect(url_for("catalog"))

    if request.method == "POST":
        name = request.form.get("name")
        phone = request.form.get("phone")
        address = request.form.get("address")

        conn = get_db_connection()
        cursor = conn.cursor()

        total_price = 0.0
        for pid_str, quantity in cart.items():
            cursor.execute(
                "SELECT price FROM inventory WHERE id = ?", (int(pid_str),)
            )
            p = cursor.fetchone()
            if p:
                total_price += p["price"] * quantity

        cursor.execute(
            "INSERT INTO orders (customer_name, phone, address, total_price, status) VALUES (?, ?, ?, ?, ?)",
            (name, phone, address, total_price, "Новый"),
        )
        order_id = cursor.lastrowid
        conn.commit()
        conn.close()

        session["cart"] = {}
        session.modified = True
        return render_template("order_success.html", order_id=order_id)

    return render_template("checkout.html")


@app.route("/order/<int:order_id>")
def view_order(order_id):
